# Copy to .env and fill in. Nothing here is required to run on simulated data.

PORT=4310

# How often to poll. Power Automate throttles aggressively; below ~20s on a real
# tenant with more than a handful of flows you will start getting 429s.
POLL_SECONDS=20

# --- data sources ------------------------------------------------------------
# Leave mock on until real credentials work, so the map is never empty.
ENABLE_MOCK=true
ENABLE_POWER_AUTOMATE=false
ENABLE_GRAPH=false

# --- Entra ID (Azure AD) app registration ------------------------------------
# See README for the six-step registration. Device-code flow: no client secret.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=common

# Leave blank to auto-detect your default Power Automate environment.
POWER_AUTOMATE_ENVIRONMENT=

# --- safety ------------------------------------------------------------------
# Write actions (re-run, turn on/off) hit your real tenant. Set false to make
# the whole app read-only.
ALLOW_WRITE_ACTIONS=true
# Require an in-app confirmation step before any write. Leave this on.
REQUIRE_CONFIRM=true
